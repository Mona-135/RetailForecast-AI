# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=retail-sales
KAFKA_PROCESSED_TOPIC=retail-sales-processed
KAFKA_CONSUMER_GROUP=retail-forecast-group

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_forecasting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/retail_forecasting
# Local SQLite fallback if PostgreSQL is offline
SQLITE_FALLBACK_URL=sqlite:///./data/retail_forecasting.db

# Big Data HDFS Configuration
HDFS_NAMENODE_URL=hdfs://localhost:9000
HDFS_WEBHDFS_URL=http://localhost:9870/webhdfs/v1
HDFS_BASE_DIR=/retail

# Forecasting Settings
FORECAST_HORIZON=7
MODEL_TYPE=auto
DATA_FREQUENCY=weekly
TARGET_MAPE_THRESHOLD=15.0

# Inventory Parameters
DEFAULT_LEAD_TIME=2
DEFAULT_SERVICE_LEVEL=0.95

# Backend API Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
